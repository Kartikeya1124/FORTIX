# ==============================================================================
# FortiX Environment Configuration Template (NON-SECRET)
# Copy this file to .env and supply cryptographically strong random values.
# NEVER commit .env to source control.
# ==============================================================================

# Application & Runtime Environment
NODE_ENV=production
PORT=3000

# Strict Persistence & Secret Enforcement
# Set to true in multi-replica clusters to reject startup if DATABASE_URL, JWT_SECRET, or Redis are absent
STRICT_PERSISTENT_DB=false
STRICT_PRODUCTION_SECRETS=false
STRICT_REDIS_READINESS=false

# Process Role Separation
# In multi-container Docker deployments, set to false on API replicas to delegate queue processing to the worker container
START_INTERNAL_WORKER=false
START_DEMO_API=false

# PostgreSQL Database Credentials
# Generate strong database password: openssl rand -hex 16
# For cloud PostgreSQL (e.g., Supabase Session Pooler over IPv4/IPv6):
#   DATABASE_URL=postgresql://postgres.<project-ref>:<percent-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   (Note: percent-encode special characters in passwords such as '@' -> '%40')
POSTGRES_USER=fortix
POSTGRES_PASSWORD=your_strong_database_password_here
POSTGRES_DB=fortix_db
DATABASE_URL=postgres://fortix:your_strong_database_password_here@localhost:5432/fortix_db

# Redis Store, BullMQ Queues & Streams
# Supports local Redis (redis://localhost:6379) or managed TLS Redis (rediss://default:<token>@<endpoint>.upstash.io:6379)
REDIS_URL=redis://localhost:6379
REDIS_FAILURE_BEHAVIOR=fail-closed

# Security Cryptographic Secrets
# CRITICAL: Must be at least 32 characters long with high entropy.
# Generate via: openssl rand -hex 32
JWT_SECRET=generate_with_openssl_rand_hex_32_minimum_32_characters

# AES-256 Symmetric Encryption Key for Sensitive Credentials
# Must be exactly 32 bytes (64 hex characters)
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY=generate_with_openssl_rand_hex_32_exactly_64_hex_digits

# CORS Origin Allowlist & Session Cookie Security
# Comma-separated list of allowed cross-origin browser origins (same-origin requests are always permitted)
ALLOWED_ORIGINS=https://your-production-domain.example.com
COOKIE_SAMESITE=lax

# PostgreSQL Row-Level Security (RLS) & Transactional Auth Notifications
ENABLE_POSTGRES_RLS=true
AUTH_MAIL_WEBHOOK_URL=
AUTH_MAIL_WEBHOOK_SECRET=

