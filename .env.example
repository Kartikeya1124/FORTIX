# ==============================================================================
# FortiX Environment Configuration Template (NON-SECRET)
# Copy this file to .env and supply cryptographically strong random values.
# NEVER commit .env to source control.
# ==============================================================================

# Application & Runtime Environment
NODE_ENV=production
PORT=3000

# Strict Persistence Enforcement
# When true, the server strictly requires a real PostgreSQL database and rejects in-memory fallbacks
STRICT_PERSISTENT_DB=true

# Process Role Separation
# In multi-container Docker deployments, set to false on API replicas to delegate queue processing to the worker container
START_INTERNAL_WORKER=false
START_DEMO_API=false

# PostgreSQL Database Credentials
# Generate strong database password: openssl rand -hex 16
POSTGRES_USER=fortix
POSTGRES_PASSWORD=your_strong_database_password_here
POSTGRES_DB=fortix_db
DATABASE_URL=postgres://fortix:your_strong_database_password_here@localhost:5432/fortix_db

# Redis In-Memory Store & Streams
REDIS_URL=redis://localhost:6379
REDIS_FAILURE_BEHAVIOR=fail-closed

# Security Cryptographic Secrets
# CRITICAL: Must be at least 32 characters long with high entropy.
# Generate via: openssl rand -hex 32
JWT_SECRET=generate_with_openssl_rand_hex_32_minimum_32_characters

# AES-256 Symmetric Encryption Key for Sensitive Credentials
# Must be exactly 32 bytes (64 hex characters)
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY=generate_with_openssl_rand_hex_32_exactly_64_hex_digits
